# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Optional: Provider routing
AI_PROVIDER=deepseek
APP_REQUEST_PROVIDER=deepseek
# APP_REQUEST_MODEL=deepseek-v4-flash

# Optional: Kimi/Moonshot for coding-heavy app specs
# KIMI_API_KEY=your_kimi_or_moonshot_api_key
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.7-code
# APP_REQUEST_PROVIDER=kimi
# APP_REQUEST_MODEL=kimi-k2.7-code

# Optional: Messaging integrations
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_COMMAND_PREFIX=!
# DISCORD_REQUIRE_MENTION=true
# DISCORD_ALLOWED_GUILD_IDS=123456789012345678
# DISCORD_APP_REQUEST_CHANNEL_IDS=123456789012345678
# WHATSAPP_PHONE_ID=your_whatsapp_phone_id

# Optional: App request build hook. Keep disabled unless command is approval-gated.
# APP_REQUEST_AUTOBUILD=false
# APP_REQUEST_BUILD_COMMAND=/path/to/approval-gated-builder

# Optional: Additional services
# ELEVENLABS_API_KEY=your_elevenlabs_key_for_tts
